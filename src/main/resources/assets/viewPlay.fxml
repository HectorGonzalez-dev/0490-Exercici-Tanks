<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="540.0" minWidth="800.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlPlay">
   <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- HUD superior -->
            <HBox alignment="CENTER" style="-fx-padding: 4;">
               <children>
                  <Label fx:id="lblPlayer1" text="Jugador 1" style="-fx-font-size: 14;" HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblPlayer2" text="Jugador 2" style="-fx-font-size: 14;" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <!-- Canvas del joc -->
            <Canvas fx:id="canvas" width="800.0" height="500.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
