<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="500.0" minWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlResult">
   <children>
      <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" prefWidth="600.0" text="Partida acabada!">
               <font><Font size="36.0" /></font>
               <VBox.margin><Insets top="50.0" /></VBox.margin>
            </Label>
            <Pane prefHeight="30.0" />
            <Label fx:id="txtWinner" alignment="CENTER" prefWidth="600.0" text="Guanyador: ?">
               <font><Font size="28.0" /></font>
            </Label>
            <Pane prefHeight="10.0" />
            <Label fx:id="txtLoser" alignment="CENTER" prefWidth="600.0" text="Perdedor: ?">
               <font><Font size="20.0" /></font>
            </Label>
            <Pane prefHeight="50.0" />
            <Button mnemonicParsing="false" onAction="#playAgain" text="Tornar a jugar">
               <VBox.margin><Insets top="16.0" /></VBox.margin>
            </Button>
            <Pane VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</AnchorPane>
